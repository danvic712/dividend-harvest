{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "DividendHarvest"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=dividend-harvest.db"
  },
  "FtShare": {
    "McpEndpoint": "",
    "StockProfileToolName": "get_stock_profile",
    "StockMarketDataToolName": "get_stock_market_data",
    "StockDividendEventsToolName": "get_stock_dividend_events",
    "StockFinancialSnapshotsToolName": "get_stock_financial_snapshots",
    "SecurityCodeArgumentName": "security_code",
    "ExchangeCodeArgumentName": "exchange_code",
    "RequestTimeoutSeconds": 30
  },
  "DailySync": {
    "Enabled": true,
    "LocalTime": "18:00",
    "TimeZoneId": "Asia/Shanghai"
  },
  "AllowedHosts": "*"
}
